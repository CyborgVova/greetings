# Скачиваем образ с предустановленным языком 'Go' и даем ему имя
# для использования на следующих этапах сборки 
FROM golang:1.25-alpine as builder

# Создаем папку и сразу заходим в нее
WORKDIR /server

# Копируем все из текущей папки хоста в текущую папку образа( /server )
COPY . .

# CGO_ENABLED=0 выключаем возможность использования 'C'-кода в Go сборке
# -ldflags - флаги линковщика Go
# '-s' удаляет символы отладки(имена функций, переменных), уменьшает размер, но затрудняет отладку
# '-w' удаляет отладочную информацию, уменьшает размер, нельзя использовать дебаггер
# CGO_ENABLED=0 + -ldflags -s -w = минимальный размер бинарника
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
go build -o server \
-ldflags="-s -w" \
./cmd/main.go

# ------------------------------------------------------------------------------- //
# В итоге в предварительном образе в папке /server будет лежать бинарник ./server //
# ------------------------------------------------------------------------------- //

# Минимльно возможный образ который умеет запускать бинарники
FROM scratch

# Создаем рабочую директорию и сразу заходим в эту папку
WORKDIR /app

# Копируем только бинарник с указанием для него прав позволяющим выполнять запуск
COPY --from=builder --chmod=755 /server/server ./server

# Указываем явно порт который будем использовать
EXPOSE 8080

# При запуске контейнера будет выполнена эта команда
CMD ["./server", "-p",  "8080"]
